{
  "name": "evmcrispr-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "evmcrispr": "*",
    "@evmcrispr/sdk": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "evmcrispr-build --bundle src/index.ts",
    "start": "bun src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "biome check src",
    "codegen": "evmcrispr-build --codegen",
    "types": "evmcrispr-build --types"
  }
}
