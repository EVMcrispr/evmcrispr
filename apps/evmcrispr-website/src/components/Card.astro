---
import { Card } from "@repo/ui";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  height?: number;
  name: string;
  info: string;
  description: string;
  animationClass?: string;
}

const {
  image,
  height = 130,
  name,
  info,
  description,
  animationClass = "",
} = Astro.props;
---

<div class:list={["w-[255px] opacity-0", animationClass]}>
  <Card tone="success" className="min-h-[470px] p-6 text-center">
    <div class="flex flex-col items-center gap-2 overflow-hidden">
      <div class="h-[160px] flex items-center justify-center">
        <img src={image.src} alt={name} style={`height: ${height}px`} />
      </div>
      <span class="text-body text-heading font-bold font-head">{name}</span>
      <span class="text-body font-bold font-clearer text-fg">{info}</span>
      <span class="text-caption font-clearer text-fg-muted">{description}</span>
    </div>
  </Card>
</div>
