---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import HeroTerminal from "../components/HeroTerminal";
import Sponsors from "../components/Sponsors.astro";
import Footer from "../components/Footer.astro";

import { Badge, buttonVariants, Notice } from "@repo/ui";
import { BookOpen, SquareTerminal } from "@repo/ui/icons";

import logo from "../assets/logo.svg";
import brett from "../assets/brett.png";
import michael from "../assets/michael.png";
import griff from "../assets/griff.png";

const TERMINAL_URL =
  import.meta.env.PUBLIC_TERMINAL_URL || "https://app.evmcrispr.com";
---

<Layout title="EVMcrispr">
  <!-- Hero: intro on the left, live terminal on the right -->
  <section
    class="max-w-6xl mx-auto px-6 pt-24 lg:pt-32 grid items-center gap-12 lg:grid-cols-2 lg:gap-16"
  >
    <div
      class="flex flex-col items-center lg:items-start gap-8 fade-in fade-in-delay-1"
    >
      <img src={logo.src} alt="EVMcrispr Logo" width="284" />

      <p class="font-clearer text-fg text-center lg:text-left text-lg lg:text-xl">
        <strong class="font-clearer text-success">EVMcrispr</strong> is a
        scripting language for Ethereum. Describe what you want to happen
        on-chain in a few readable lines, simulate it before it touches your
        wallet, and{" "}
        <strong class="font-clearer text-success">
          share scripts anyone can read, review and run
        </strong>.
      </p>

      <!-- Equal-width grid tracks size both buttons to the wider one. -->
      <div class="grid sm:grid-cols-2 items-center gap-4">
        <a
          href={TERMINAL_URL}
          class={buttonVariants({
            variant: "primary",
            size: "lg",
            className: "gap-3 whitespace-nowrap",
          })}
        >
          <SquareTerminal className="size-5 shrink-0" />
          Open Terminal
        </a>
        <a
          href="/intro/getting-started/"
          class={buttonVariants({
            variant: "neutral",
            size: "lg",
            className: "gap-3 whitespace-nowrap",
          })}
        >
          <BookOpen className="size-5 shrink-0" />
          Get Started
        </a>
      </div>
    </div>

    <!-- On desktop the terminal absolutely fills its stretched grid cell, so
         the intro column alone decides the row height and the terminal always
         matches it exactly (its own content can't inflate the row). When the
         columns stack on small screens it flows normally with a min-height. -->
    <div class="relative w-full min-w-0 lg:self-stretch fade-in fade-in-delay-2">
      <div class="min-h-[340px] flex flex-col lg:absolute lg:inset-0 lg:min-h-0">
        <HeroTerminal client:only="react" />
      </div>
    </div>
  </section>

  <main class="max-w-[956px] mx-auto">
    <!-- MCP notification banner -->
    <div class="flex justify-center px-6 mt-20 mb-8 fade-in fade-in-delay-3">
      <Notice tone="success" className="max-w-full">
        <span class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-title text-fg">
          <Badge variant="tag" tone="success" dot>NEW</Badge>
          <span>
            EVMcrispr now works with{" "}
            <strong class="font-bold text-success">AI agents</strong> via MCP
          </span>
        </span>
        <a
          slot="action"
          href="/guides/mcp/"
          class={buttonVariants({ variant: "quiet", size: "sm" })}
        >
          Connect →
        </a>
      </Notice>
    </div>

    <!-- Testimonials heading -->
    <h1 class="pt-16 text-center text-2xl font-bold text-heading font-head fade-in fade-in-delay-3">
      Who's using EVMcrispr?
    </h1>

    <!-- Testimonial cards -->
    <div class="flex flex-col lg:flex-row justify-center items-center pt-8 mb-28 w-full gap-16 pr-4 md:pr-0">
      <Card
        image={michael}
        name="Michael Egorov"
        info="Founder of Curve"
        description={`"We had an important upgrade of CurveDAO (based on Aragon) which had to be very well tested given that the DAO controls parameters of a platform which holds more than $20B USD worth of assets. EVMcrispr helped to get this upgrade done safely."`}
        animationClass="card-reveal card-reveal-delay-1"
      />
      <Card
        image={griff}
        name="Griff Green"
        info="TheDAO curator"
        description={`"As a non-dev Ethereum power user, I would be lost without EVMcrispr. I use it nearly every day — to mint NFTs, to build reusable payroll scripts, to craft complex atomic transactions. The best part? I can hand a script to anyone to review, and they actually understand it."`}
        animationClass="card-reveal card-reveal-delay-2"
      />
      <Card
        image={brett}
        height={150}
        name="Brett Sun"
        info="Former Aragon CTO"
        description={`"EVMCrispr is the tool every aragonOS DAO has been waiting for. It presents a step change in DAO operations that enables everyone to invoke complex proposals—not just those brave enough to write complex transaction-generating code."`}
        animationClass="card-reveal card-reveal-delay-3"
      />
    </div>
  </main>

  <Sponsors />
  <Footer />
</Layout>
