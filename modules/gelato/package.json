{
  "name": "@evmcrispr/module-gelato",
  "version": "0.11.1",
  "description": "Gelato automation: run EVML scripts off-chain on a trigger through the EVML runner Web3 Function (gelato:schedule, interval, cron, event or one-shot), freeze the calls of an EVML block into an Automate task (gelato:automate, optionally gated by an on-chain checker), fund and withdraw the Gas Tank (1Balance) that pays for executions, run tasks inside a simulation, and read tasks, balances and dedicated msg.senders back.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EVMcrispr/evmcrispr.git",
    "directory": "modules/gelato"
  },
  "homepage": "https://evmcrispr.com",
  "bugs": "https://github.com/EVMcrispr/evmcrispr/issues",
  "experimental": true,
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@evmcrispr/module-std": "workspace:^",
    "@evmcrispr/sdk": "workspace:^"
  },
  "devDependencies": {
    "@evmcrispr/test-utils": "workspace:*"
  },
  "peerDependencies": {
    "viem": "^2.54.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "lint": "biome check src",
    "type-check": "tsgo -p tsconfig.json",
    "build": "evmcrispr-build --bundle",
    "test:unit": "bun test ./test/unit",
    "test:integration": "bun test ./test/integration",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-skip-test-files ./test",
    "codegen": "evmcrispr-build --codegen",
    "publish-runner": "bun scripts/publish-runner.ts",
    "types": "evmcrispr-build --types"
  }
}
