{
  "name": "@evmcrispr/module-sim",
  "version": "0.1.0",
  "license": "GPL-3.0",
  "description": "Simulation module: fork chains and execute commands in a sandboxed environment using Anvil, Hardhat, Tenderly, or EthereumJS backends. Forks are multichain: `switch` moves between one fork per chain, and bridge transfers are auto-relayed to the destination fork.",
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ethereumjs/common": "^10.1.2",
    "@ethereumjs/statemanager": "^10.1.2",
    "@ethereumjs/util": "^10.1.2",
    "@ethereumjs/vm": "^10.1.2",
    "@evmcrispr/sdk": "workspace:*"
  },
  "devDependencies": {
    "@evmcrispr/test-utils": "workspace:*"
  },
  "peerDependencies": {
    "viem": "^2.54.1"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "biome check src",
    "type-check": "tsgo -p tsconfig.json",
    "build": "evmcrispr-build --bundle",
    "test:unit": "bun test ./test/unit",
    "test:integration": "bun test ./test/integration",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-skip-test-files ./test",
    "codegen": "evmcrispr-build --codegen",
    "types": "evmcrispr-build --types"
  }
}
