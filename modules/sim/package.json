{
  "name": "@evmcrispr/module-sim",
  "version": "0.1.0",
  "license": "GPL-3.0",
  "description": "Fork a chain locally, simulate transactions, set balances, and assert outcomes.",
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ethereumjs/common": "^10.1.1",
    "@ethereumjs/statemanager": "^10.1.1",
    "@ethereumjs/util": "^10.1.1",
    "@ethereumjs/vm": "^10.1.1",
    "@evmcrispr/sdk": "workspace:*"
  },
  "devDependencies": {
    "@evmcrispr/test-utils": "workspace:*"
  },
  "peerDependencies": {
    "viem": "^2.29.4"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "biome check src",
    "type-check": "tsc -p tsconfig.json",
    "build": "evmcrispr-build",
    "test:unit": "bun test ./test/unit",
    "test:integration": "bun test ./test/integration",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-skip-test-files ./test"
  }
}
