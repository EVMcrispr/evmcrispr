{
  "name": "@evmcrispr/module-sim",
  "version": "0.11.0",
  "description": "Simulation module: fork chains and execute commands in a sandboxed environment using Anvil, Hardhat, Tenderly, EthereumJS or Revm (WASM) backends. Forks are multichain: `switch` moves between one fork per chain, and bridge transfers are auto-relayed to the destination fork.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EVMcrispr/evmcrispr.git",
    "directory": "modules/sim"
  },
  "homepage": "https://evmcrispr.com",
  "bugs": "https://github.com/EVMcrispr/evmcrispr/issues",
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ethereumjs/common": "^10.1.2",
    "@ethereumjs/statemanager": "^10.1.2",
    "@ethereumjs/util": "^10.1.2",
    "@ethereumjs/vm": "^10.1.2",
    "@evmcrispr/sdk": "workspace:^"
  },
  "devDependencies": {
    "@evmcrispr/module-contracts": "workspace:*",
    "@evmcrispr/module-token": "workspace:*",
    "@evmcrispr/test-utils": "workspace:*"
  },
  "peerDependencies": {
    "viem": "^2.54.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "lint": "biome check src",
    "type-check": "tsgo -p tsconfig.json",
    "build": "evmcrispr-build --bundle --assets=src/lib/revm/pkg:pkg",
    "test:unit": "bun test ./test/unit",
    "test:integration": "bun test ./test/integration",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-skip-test-files ./test",
    "codegen": "evmcrispr-build --codegen",
    "types": "evmcrispr-build --types",
    "build:wasm": "bun ../../scripts/build-wasm.ts",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml"
  }
}
