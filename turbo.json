{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/_generated.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "type-check": {
      "dependsOn": [
        "build",
        "^build",
        "@evmcrispr/core#build",
        "@evmcrispr/module-std#build"
      ]
    },
    "evmcrispr-website#type-check": {
      "dependsOn": ["^build"]
    },
    "evmcrispr-terminal#type-check": {
      "dependsOn": ["^build"]
    },
    "evmcrispr-mcp#build": {
      "dependsOn": ["evmcrispr#build", "^build"]
    },
    "evmcrispr-mcp#type-check": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
