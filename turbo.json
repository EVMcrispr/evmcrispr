{
  "$schema": "https://v2-9-7.turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "ASSERTIONS_ARTIFACTS",
    "KERNEL_FIXTURE_ROOT",
    "NEXUS_FIXTURE_ROOT",
    "SMART_PROTOCOL_ARTIFACT",
    "EEZ_DEVNET",
    "EVMCRISPR_RPC_URL_1",
    "EVMCRISPR_RPC_URL_10",
    "EVMCRISPR_RPC_URL_100",
    "EVMCRISPR_RPC_URL_137",
    "EVMCRISPR_RPC_URL_8453",
    "EVMCRISPR_RPC_URL_42161",
    "EVMCRISPR_RPC_URL_699169",
    "EVMCRISPR_RPC_URL_10200",
    "FORCE_INTEGRATION",
    "EVMCRISPR_FRAME_DEVNET",
    "EVMCRISPR_ANVIL_PORT",
    "XDG_RUNTIME_DIR",
    "NPM_CONFIG_REGISTRY"
  ],
  "tasks": {
    "codegen": {
      "outputs": ["src/_generated.ts"]
    },
    "@evmcrispr/modules#codegen": {
      "inputs": ["$TURBO_DEFAULT$", "../../modules/*/package.json"],
      "outputs": ["src/_generated.ts"]
    },
    "@evmcrispr/editor#codegen": {
      "inputs": ["$TURBO_DEFAULT$", "../../modules/std/src/commands/*.ts"],
      "outputs": ["src/_generated.ts", "src/grammars/evml.tmLanguage.json"]
    },
    "types": {
      "dependsOn": ["codegen", "^types"],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map"]
    },
    "build": {
      "dependsOn": ["codegen", "types"],
      "outputs": ["dist/**", "!dist/**/*.d.ts", "!dist/**/*.d.ts.map"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "type-check": {
      "dependsOn": [
        "codegen",
        "^types",
        "@evmcrispr/core#types",
        "@evmcrispr/module-std#types"
      ]
    },
    "//#generate-docs": {
      "env": ["VITE_PUBLIC_EXPERIMENTAL"],
      "outputs": [
        "apps/evmcrispr-website/src/content/docs/reference/**",
        "apps/evmcrispr-website/public/llms-full.txt"
      ]
    },
    "evmcrispr-website#build": {
      "env": ["VITE_PUBLIC_EXPERIMENTAL"],
      "dependsOn": ["^build", "//#generate-docs"]
    },
    "evmcrispr-website#dev": {
      "cache": false,
      "persistent": true,
      "env": ["VITE_PUBLIC_EXPERIMENTAL"],
      "dependsOn": ["//#generate-docs"]
    },
    "evmcrispr-website#type-check": {
      "dependsOn": ["^types"]
    },
    "evmcrispr-terminal#build": {
      "env": ["VITE_PUBLIC_EXPERIMENTAL"],
      "inputs": ["$TURBO_DEFAULT$", "../../modules/*/package.json"],
      "dependsOn": ["^build"]
    },
    "evmcrispr-terminal#type-check": {
      "dependsOn": ["^types"]
    },
    "evmcrispr-api#build": {
      "env": ["VITE_PUBLIC_EXPERIMENTAL"],
      "dependsOn": ["codegen", "types", "evmcrispr#build", "^build"]
    },
    "evmcrispr-api#type-check": {
      "dependsOn": ["codegen", "^types"]
    },
    "lint": {},
    "test:unit": {
      "dependsOn": ["codegen", "^codegen"]
    },
    "test:integration": {
      "dependsOn": ["codegen", "^codegen"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["codegen", "^codegen"],
      "cache": false
    }
  }
}
