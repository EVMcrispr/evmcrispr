{
  "private": true,
  "overrides": {
    "@types/node": "^26.6.2",
    "viem": "^2.56.8"
  },
  "scripts": {
    "postinstall": "ln -sf ../../packages/sdk/scripts/build.ts node_modules/.bin/evmcrispr-build && ln -sf ../../packages/cli/src/bin.ts node_modules/.bin/evmcrispr",
    "prepare": "husky",
    "build": "turbo run build",
    "release": "turbo run build type-check && bun scripts/publish-packages.ts",
    "bump": "bun scripts/bump-version.ts",
    "type-check": "turbo run type-check",
    "lint": "biome check . && bun run lint:tailwind",
    "lint:fix": "biome check --write .",
    "lint:tailwind": "bun scripts/check-tailwind-deprecations.ts",
    "format": "biome format --write .",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "turbo run test:unit --continue",
    "test:integration": "bun scripts/run-integration-tests.ts",
    "test:coverage": "bun scripts/run-coverage.ts",
    "dev:terminal": "bun --filter evmcrispr-terminal dev",
    "generate-docs": "bun scripts/generate-docs.ts",
    "sync-modules": "bun scripts/sync-modules.ts",
    "validate-docs": "bun scripts/validate-docs.ts",
    "dev:website": "bun --filter evmcrispr-website dev",
    "dev:mcp": "bun --filter evmcrispr-mcp dev",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2"
  },
  "name": "evmcrispr-monorepo",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "dependencies": {
    "@evmcrispr/core": "workspace:*",
    "@evmcrispr/module-acl": "workspace:*",
    "@evmcrispr/module-aragonos": "workspace:*",
    "@evmcrispr/module-aragonosx": "workspace:*",
    "@evmcrispr/module-bridges": "workspace:*",
    "@evmcrispr/module-circom": "workspace:*",
    "@evmcrispr/module-contracts": "workspace:*",
    "@evmcrispr/module-crypto": "workspace:*",
    "@evmcrispr/module-eez": "workspace:*",
    "@evmcrispr/module-ens": "workspace:*",
    "@evmcrispr/module-giveth": "workspace:*",
    "@evmcrispr/module-governor": "workspace:*",
    "@evmcrispr/module-http": "workspace:*",
    "@evmcrispr/module-lang": "workspace:*",
    "@evmcrispr/module-lending": "workspace:*",
    "@evmcrispr/module-math": "workspace:*",
    "@evmcrispr/module-noir": "workspace:*",
    "@evmcrispr/module-proxies": "workspace:*",
    "@evmcrispr/module-receipts": "workspace:*",
    "@evmcrispr/module-safe": "workspace:*",
    "@evmcrispr/module-semaphore": "workspace:*",
    "@evmcrispr/module-sim": "workspace:*",
    "@evmcrispr/module-std": "workspace:*",
    "@evmcrispr/module-superfluid": "workspace:*",
    "@evmcrispr/module-swaps": "workspace:*",
    "@evmcrispr/module-token": "workspace:*",
    "@evmcrispr/module-vault": "workspace:*",
    "@evmcrispr/sdk": "workspace:*",
    "viem": "^2.56.8"
  }
}
