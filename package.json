{
  "private": true,
  "overrides": {
    "viem": "^2.54.1"
  },
  "scripts": {
    "postinstall": "ln -sf ../../packages/sdk/scripts/build.ts node_modules/.bin/evmcrispr-build && ln -sf ../../packages/cli/src/bin.ts node_modules/.bin/evmcrispr",
    "prepare": "husky",
    "build": "turbo run build",
    "changeset:release": "turbo run build && changeset publish",
    "changeset:version": "changeset version && bun install --lockfile-only",
    "type-check": "turbo run type-check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "bun scripts/run-integration-tests.ts",
    "test:coverage": "bun scripts/run-coverage.ts",
    "dev:terminal": "bun --filter evmcrispr-terminal dev",
    "generate-docs": "bun scripts/generate-docs.ts",
    "dev:website": "bun --filter evmcrispr-website dev",
    "dev:mcp": "bun --filter evmcrispr-mcp dev",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24.13.2",
    "@typescript/native-preview": "^7.0.0-dev.20260702.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.10.2",
    "typescript": "^6.0.3"
  },
  "name": "evmcrispr-monorepo",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "dependencies": {
    "viem": "^2.46.3"
  }
}
