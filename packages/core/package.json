{
  "name": "@evmcrispr/core",
  "version": "0.11.1",
  "description": "EVML interpreter and workspace runtime: parse, validate, simulate and execute EVML scripts with any viem wallet",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EVMcrispr/evmcrispr.git",
    "directory": "packages/core"
  },
  "homepage": "https://evmcrispr.com",
  "bugs": "https://github.com/EVMcrispr/evmcrispr/issues",
  "codename": "new foundations",
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "bun": "./src/worker/expose.ts",
      "types": "./dist/worker/expose.d.ts",
      "import": "./dist/worker/expose.js"
    },
    "./worker-client": {
      "bun": "./src/worker/client.ts",
      "types": "./dist/worker/client.d.ts",
      "import": "./dist/worker/client.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@evmcrispr/test-utils": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/chai": "^5.2.3",
    "@types/lodash.clonedeep": "^4.5.9",
    "dotenv": "^17.4.2",
    "is-ipfs": "^8.0.4",
    "msw": "^2.14.6",
    "ora": "^9.4.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@evmcrispr/module-std": "workspace:^",
    "@evmcrispr/sdk": "workspace:^",
    "arcsecond": "^5.0.0"
  },
  "peerDependencies": {
    "viem": "^2.54.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "lint": "biome check src",
    "type-check": "tsgo --noEmit",
    "test:unit": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-skip-test-files",
    "build": "evmcrispr-build --bundle --splitting src/index.ts src/worker/expose.ts src/worker/client.ts",
    "codegen": "evmcrispr-build --codegen",
    "types": "evmcrispr-build --types"
  }
}
