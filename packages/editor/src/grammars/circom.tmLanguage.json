{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "circom",
  "scopeName": "source.circom",
  "comment": "Circom grammar for <<<CIRCOM heredocs. Circom's surface syntax is C/JavaScript-flavored (the official iden3 grammar is literally the JS grammar plus three rules), so this follows JS conventions with circom's own keywords and constraint operators layered on top. Keep in sync with the Monarch grammar in src/editor/circom-language.ts.",
  "patterns": [
    {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.circom"
    },
    {
      "match": "//.*$",
      "name": "comment.line.double-slash.circom"
    },
    {
      "match": "<==|==>|<--|-->|===",
      "name": "keyword.operator.constraint.circom"
    },
    {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.circom",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.circom"
        }
      ]
    },
    {
      "match": "\\b0x[0-9a-fA-F]+\\b",
      "name": "constant.numeric.hexadecimal.circom"
    },
    {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.circom"
    },
    {
      "match": "\\b(template|function)\\s+([a-zA-Z_$][a-zA-Z0-9_$]*)",
      "captures": {
        "1": { "name": "keyword.circom" },
        "2": { "name": "entity.name.function.circom" }
      }
    },
    {
      "match": "\\b(pragma|circom|custom_templates|include|template|function|component|main|public|signal|input|output|var|if|else|for|while|do|return|assert|log|parallel|custom|bus)\\b",
      "name": "keyword.circom"
    },
    {
      "match": "\\b_*[A-Z][a-zA-Z0-9_$]*\\b",
      "name": "entity.name.type.circom"
    },
    {
      "match": "\\b[a-z_$][a-zA-Z0-9_$]*(?=\\s*\\()",
      "name": "entity.name.function.circom"
    },
    {
      "match": "[<>!~?:&|+\\-*/^%=]+",
      "name": "keyword.operator.circom"
    },
    {
      "match": "\\b[a-zA-Z_$][a-zA-Z0-9_$]*\\b",
      "name": "variable.other.circom"
    }
  ],
  "repository": {}
}
