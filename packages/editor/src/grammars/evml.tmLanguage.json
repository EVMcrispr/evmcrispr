{
  "name": "evml",
  "displayName": "EVML",
  "scopeName": "source.evml",
  "fileTypes": ["evml"],
  "patterns": [
    {
      "include": "#reference-number"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#heredoc-solidity"
    },
    {
      "include": "#heredoc-json"
    },
    {
      "include": "#heredoc-circom"
    },
    {
      "include": "#heredoc-noir"
    },
    {
      "include": "#heredoc-typescript"
    },
    {
      "include": "#heredoc"
    },
    {
      "include": "#string-double"
    },
    {
      "include": "#string-single"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#helper"
    },
    {
      "include": "#boolean"
    },
    {
      "include": "#number"
    },
    {
      "include": "#option-flag"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#module-command"
    },
    {
      "include": "#named-arg"
    },
    {
      "include": "#command"
    }
  ],
  "repository": {
    "reference-number": {
      "match": "#[0-9]+\\b",
      "name": "constant.numeric.reference.evml"
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.evml"
    },
    "heredoc-solidity": {
      "begin": "<<<(SOL)\\b[ \\t]*$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.heredoc.begin.evml"
        }
      },
      "end": "^(SOL)\\b",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.heredoc.end.evml"
        }
      },
      "contentName": "meta.embedded.block.solidity",
      "patterns": [
        {
          "include": "source.solidity"
        }
      ]
    },
    "heredoc-json": {
      "begin": "<<<(JSON)\\b[ \\t]*$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.heredoc.begin.evml"
        }
      },
      "end": "^(JSON)\\b",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.heredoc.end.evml"
        }
      },
      "contentName": "meta.embedded.block.json",
      "patterns": [
        {
          "include": "source.json"
        }
      ]
    },
    "heredoc-circom": {
      "begin": "<<<(CIRCOM)\\b[ \\t]*$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.heredoc.begin.evml"
        }
      },
      "end": "^(CIRCOM)\\b",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.heredoc.end.evml"
        }
      },
      "contentName": "meta.embedded.block.circom",
      "patterns": [
        {
          "include": "source.circom"
        }
      ]
    },
    "heredoc": {
      "begin": "<<<([A-Z][A-Z0-9]*)\\b",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.heredoc.begin.evml"
        }
      },
      "end": "^(\\1)\\b",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.heredoc.end.evml"
        }
      },
      "name": "string.unquoted.heredoc.evml"
    },
    "string-double": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.evml",
      "patterns": [
        {
          "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|[nrt\\\\'\"])",
          "name": "constant.character.escape.evml"
        }
      ]
    },
    "string-single": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.evml",
      "patterns": [
        {
          "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|[nrt\\\\'\"])",
          "name": "constant.character.escape.evml"
        }
      ]
    },
    "variable": {
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "variable.other.evml"
    },
    "helper": {
      "match": "@[a-zA-Z][a-zA-Z0-9._-]*!?(?::[a-zA-Z][a-zA-Z0-9._-]*!?)?",
      "name": "entity.name.function.helper.evml"
    },
    "boolean": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.evml"
    },
    "number": {
      "match": "(?:\\b0x[0-9a-fA-F]+|(?<![\\w-])-?[0-9]+(?:\\.[0-9]+)?(?:e[0-9]+)?(?:eth|gwei|wei|s|mo|h|d|w|m|y)?(?:/(?:s|mo|h|d|w|m|y))?)\\b",
      "name": "constant.numeric.evml"
    },
    "option-flag": {
      "match": "--[a-zA-Z][a-zA-Z0-9-]*",
      "name": "entity.name.tag.option.evml"
    },
    "operator": {
      "patterns": [
        {
          "match": "!::",
          "name": "keyword.operator.namespace.evml"
        },
        {
          "match": "::",
          "name": "keyword.operator.namespace.evml"
        },
        {
          "match": "-\\?!>",
          "name": "keyword.operator.error-capture-optional.evml"
        },
        {
          "match": "-!>",
          "name": "keyword.operator.error-capture.evml"
        },
        {
          "match": "->",
          "name": "keyword.operator.arrow.evml"
        },
        {
          "match": "=>",
          "name": "keyword.operator.arrow.evml"
        },
        {
          "match": "(?<=\\s)\\$\\*?>(?=\\s)",
          "name": "keyword.operator.arrow.evml"
        }
      ]
    },
    "module-command": {
      "match": "^\\s*([a-zA-Z][a-zA-Z0-9]*:[a-zA-Z][a-zA-Z0-9-]*)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.module-command.evml"
        }
      }
    },
    "command": {
      "comment": "Auto-generated from modules/std/src/commands by scripts/codegen-grammar.ts — do not edit by hand.",
      "match": "\\b(?:assert|batch|def|exec|exit|if|load|loop|print|send|set|sign|switch|wait)\\b",
      "name": "keyword.control.evml"
    },
    "named-arg": {
      "match": "\\b([a-zA-Z][a-zA-Z0-9-]*)(:)(?![/:])",
      "captures": {
        "1": {
          "name": "variable.parameter.evml"
        },
        "2": {
          "name": "punctuation.separator.named-arg.evml"
        }
      }
    },
    "heredoc-noir": {
      "begin": "<<<(NOIR)\\b[ \\t]*$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.heredoc.begin.evml"
        }
      },
      "end": "^(NOIR)\\b",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.heredoc.end.evml"
        }
      },
      "contentName": "meta.embedded.block.noir",
      "patterns": [
        {
          "include": "source.noir"
        }
      ]
    },
    "heredoc-typescript": {
      "begin": "<<<(TS)\\b[ \\t]*$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.heredoc.begin.evml"
        }
      },
      "end": "^(TS)\\b",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.heredoc.end.evml"
        }
      },
      "contentName": "meta.embedded.block.typescript",
      "patterns": [
        {
          "include": "source.ts"
        }
      ]
    }
  }
}
