{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "noir",
  "scopeName": "source.noir",
  "comment": "Noir grammar for <<<NOIR heredocs, adapted from the official noir-lang/vscode-noir extension (Apache-2.0), which models Noir on Rust. Scope suffixes are .noir (not upstream's .nr) and struct-field/path rules are simplified to what evml-theme.ts actually colors. Keep in sync with the Monarch grammar in src/editor/noir-language.ts.",
  "patterns": [
    {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.noir"
    },
    {
      "match": "//.*$",
      "name": "comment.line.double-slash.noir"
    },
    {
      "match": "#!?\\[[^\\]]*\\]",
      "name": "meta.attribute.noir"
    },
    {
      "begin": "r(#*)\"",
      "end": "\"\\1",
      "name": "string.quoted.double.noir"
    },
    {
      "begin": "f\"",
      "end": "\"",
      "name": "string.interpolated.noir",
      "patterns": [
        {
          "match": "\\\\.|\\{\\{|\\}\\}",
          "name": "constant.character.escape.noir"
        },
        {
          "match": "\\{[^\"{}]*\\}",
          "name": "variable.other.interpolation.noir"
        }
      ]
    },
    {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.noir",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.noir"
        }
      ]
    },
    {
      "match": "\\b0x[0-9a-fA-F_]+\\b",
      "name": "constant.numeric.hexadecimal.noir"
    },
    {
      "match": "\\b[0-9][0-9_]*\\b",
      "name": "constant.numeric.noir"
    },
    {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.noir"
    },
    {
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.noir" },
        "2": { "name": "support.function.noir" }
      }
    },
    {
      "match": "\\b(fn|impl|trait|type|mod|use|struct|enum|match|if|else|for|loop|while|break|continue)\\b",
      "name": "keyword.control.noir"
    },
    {
      "match": "\\b(global|comptime|quote|unsafe|unconstrained|pub|crate|mut|self|in|as|let|where|super|dep|contract)\\b",
      "name": "keyword.noir"
    },
    {
      "match": "\\b([ui]\\d+|str|fmtstr|bool|field|Field)\\b",
      "name": "support.type.noir"
    },
    {
      "match": "\\b_*[A-Z][a-zA-Z0-9_]*\\b",
      "name": "support.type.noir"
    },
    {
      "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*(::<[^>]*>)?\\s*\\()",
      "name": "support.function.noir"
    },
    {
      "match": "->|=>|::",
      "name": "keyword.operator.noir"
    },
    {
      "match": "[<>!~?:&|+\\-*/^%=]+",
      "name": "keyword.operator.noir"
    },
    {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.noir"
    }
  ],
  "repository": {}
}
