{
  "name": "@evmcrispr/editor",
  "version": "0.11.1",
  "description": "Embeddable Monaco-based EVML editor React components with syntax highlighting, completions and diagnostics",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EVMcrispr/evmcrispr.git",
    "directory": "packages/editor"
  },
  "homepage": "https://evmcrispr.com",
  "bugs": "https://github.com/EVMcrispr/evmcrispr/issues",
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./monaco": {
      "bun": "./src/editor/MonacoEditor.tsx",
      "types": "./dist/editor/MonacoEditor.d.ts",
      "import": "./dist/editor/MonacoEditor.js"
    },
    "./style.css": "./dist/style.css",
    "./styles/components.css": "./src/styles/components.css",
    "./grammars/circom": "./src/grammars/circom.tmLanguage.json",
    "./grammars/evml": "./src/grammars/evml.tmLanguage.json",
    "./grammars/noir": "./src/grammars/noir.tmLanguage.json",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@evmcrispr/core": "workspace:^",
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-popover": "^1.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "monaco-editor": "0.56.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "viem": "^2.54.1"
  },
  "devDependencies": {
    "@evmcrispr/sdk": "workspace:*",
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "lint": "biome check src",
    "type-check": "tsgo --noEmit",
    "build": "evmcrispr-build --bundle ./src/index.ts ./src/editor/MonacoEditor.tsx --splitting --production && bun scripts/build-css.ts",
    "codegen": "evmcrispr-build --codegen && bun scripts/codegen-grammar.ts",
    "types": "evmcrispr-build --types"
  }
}
