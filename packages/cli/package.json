{
  "name": "evmcrispr",
  "version": "0.11.1",
  "description": "EVMcrispr command line: validate, simulate and share EVML scripts for batching EVM transactions",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EVMcrispr/evmcrispr.git",
    "directory": "packages/cli"
  },
  "homepage": "https://evmcrispr.com",
  "bugs": "https://github.com/EVMcrispr/evmcrispr/issues",
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": false,
  "main": "dist/bin.js",
  "types": "dist/bin.d.ts",
  "bin": {
    "evmcrispr": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "bun": "./src/bin.ts",
      "types": "./dist/bin.d.ts",
      "import": "./dist/bin.js"
    },
    "./tools/*": {
      "bun": "./src/tools/*.ts",
      "types": "./dist/tools/*.d.ts",
      "import": "./dist/tools/*.js"
    },
    "./lib/*": {
      "bun": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    }
  },
  "dependencies": {
    "@evmcrispr/core": "workspace:^",
    "@evmcrispr/modules": "workspace:^",
    "@evmcrispr/sdk": "workspace:^",
    "viem": "^2.54.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.2"
  },
  "files": [
    "dist",
    "docs",
    "src"
  ],
  "scripts": {
    "prebuild": "bun scripts/bundle-docs.ts",
    "build": "evmcrispr-build --bundle src/bin.ts",
    "postbuild": "bun scripts/fix-shebang.ts",
    "test:unit": "bun test",
    "type-check": "tsgo --noEmit",
    "lint": "biome check src",
    "codegen": "evmcrispr-build --codegen",
    "types": "evmcrispr-build --types"
  }
}
