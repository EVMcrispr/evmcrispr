{
  "name": "evmcrispr",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "CLI and MCP server for EVMcrispr \u2014 simulate, validate, and author EVML scripts",
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": false,
  "main": "dist/bin.js",
  "types": "dist/bin.d.ts",
  "bin": {
    "evmcrispr": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "bun": "./src/bin.ts",
      "types": "./dist/bin.d.ts",
      "import": "./dist/bin.js"
    },
    "./tools/*": {
      "bun": "./src/tools/*.ts",
      "types": "./dist/tools/*.d.ts",
      "import": "./dist/tools/*.js"
    },
    "./lib/*": {
      "bun": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    }
  },
  "dependencies": {
    "@evmcrispr/core": "*",
    "@evmcrispr/modules": "*",
    "@evmcrispr/sdk": "*",
    "viem": "^2.54.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.2"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "prebuild": "bun scripts/bundle-docs.ts",
    "build": "evmcrispr-build --bundle src/bin.ts",
    "test:unit": "bun test",
    "type-check": "tsgo --noEmit",
    "lint": "biome check src",
    "codegen": "evmcrispr-build --codegen",
    "types": "evmcrispr-build --types"
  }
}
