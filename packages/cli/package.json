{
  "name": "evmcrispr",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "CLI and MCP server for EVMcrispr — simulate, validate, and author EVML scripts",
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": false,
  "main": "dist/bin.js",
  "types": "dist/bin.d.ts",
  "bin": {
    "evmcrispr": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "bun": "./src/bin.ts",
      "types": "./dist/bin.d.ts",
      "import": "./dist/bin.js"
    },
    "./tools/*": {
      "bun": "./src/tools/*.ts",
      "types": "./dist/tools/*.d.ts",
      "import": "./dist/tools/*.js"
    },
    "./lib/*": {
      "bun": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    }
  },
  "dependencies": {
    "@evmcrispr/core": "*",
    "@evmcrispr/module-aragonos": "*",
    "@evmcrispr/module-ens": "*",
    "@evmcrispr/module-giveth": "*",
    "@evmcrispr/module-lang": "*",
    "@evmcrispr/module-http": "*",
    "@evmcrispr/module-sim": "*",
    "viem": "^2.45.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^22.15.21"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "prebuild": "bun scripts/bundle-docs.ts",
    "build": "evmcrispr-build src/bin.ts",
    "test:unit": "bun test",
    "type-check": "tsc --noEmit",
    "lint": "biome check src"
  }
}
