{
  "name": "@evmcrispr/ai",
  "version": "0.11.1",
  "description": "Headless AI agent toolkit for EVML hosts: DappNode Nexus client + auth, script/contract/docs/web tools, and a React hook to drive any chat UI",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EVMcrispr/evmcrispr.git",
    "directory": "packages/ai"
  },
  "homepage": "https://evmcrispr.com",
  "bugs": "https://github.com/EVMcrispr/evmcrispr/issues",
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.54",
    "@evmcrispr/sdk": "workspace:^",
    "ai": "^7.0.112",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@evmcrispr/core": "workspace:^",
    "react": "^19.2.4",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@evmcrispr/core": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "vite": "^8.3.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "lint": "biome check src test",
    "test:unit": "bun test",
    "type-check": "tsc --noEmit",
    "build": "evmcrispr-build --bundle",
    "types": "evmcrispr-build --types"
  }
}
