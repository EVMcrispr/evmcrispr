{
  "name": "@evmcrispr/modules",
  "version": "0.11.0",
  "description": "Meta-package that registers all official EVMcrispr modules",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EVMcrispr/evmcrispr.git",
    "directory": "packages/modules"
  },
  "homepage": "https://evmcrispr.com",
  "bugs": "https://github.com/EVMcrispr/evmcrispr/issues",
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./order": {
      "bun": "./src/order.ts",
      "types": "./dist/order.d.ts",
      "import": "./dist/order.js"
    }
  },
  "dependencies": {
    "@evmcrispr/core": "workspace:^",
    "@evmcrispr/module-acl": "workspace:^",
    "@evmcrispr/module-aragonos": "workspace:^",
    "@evmcrispr/module-aragonosx": "workspace:^",
    "@evmcrispr/module-assertions": "workspace:^",
    "@evmcrispr/module-bridges": "workspace:^",
    "@evmcrispr/module-circom": "workspace:^",
    "@evmcrispr/module-contracts": "workspace:^",
    "@evmcrispr/module-crypto": "workspace:^",
    "@evmcrispr/module-ens": "workspace:^",
    "@evmcrispr/module-explorer": "workspace:^",
    "@evmcrispr/module-giveth": "workspace:^",
    "@evmcrispr/module-governor": "workspace:^",
    "@evmcrispr/module-http": "workspace:^",
    "@evmcrispr/module-lang": "workspace:^",
    "@evmcrispr/module-lending": "workspace:^",
    "@evmcrispr/module-proxies": "workspace:^",
    "@evmcrispr/module-safe": "workspace:^",
    "@evmcrispr/module-semaphore": "workspace:^",
    "@evmcrispr/module-sim": "workspace:^",
    "@evmcrispr/module-std": "workspace:^",
    "@evmcrispr/module-superfluid": "workspace:^",
    "@evmcrispr/module-swaps": "workspace:^",
    "@evmcrispr/module-token": "workspace:^",
    "@evmcrispr/module-vault": "workspace:^"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.2"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "lint": "biome check src scripts",
    "type-check": "tsgo --noEmit",
    "build": "evmcrispr-build --bundle src/index.ts src/order.ts",
    "codegen": "bun scripts/codegen.ts",
    "types": "evmcrispr-build --types"
  }
}
