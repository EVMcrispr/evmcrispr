{
  "name": "@evmcrispr/modules",
  "version": "0.1.0",
  "license": "GPL-3.0",
  "description": "Meta-package that depends on and registers every EVMcrispr module",
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./order": {
      "bun": "./src/order.ts",
      "types": "./dist/order.d.ts",
      "import": "./dist/order.js"
    }
  },
  "dependencies": {
    "@evmcrispr/core": "*",
    "@evmcrispr/module-access-control": "*",
    "@evmcrispr/module-aragonos": "*",
    "@evmcrispr/module-aragonosx": "*",
    "@evmcrispr/module-assertions": "*",
    "@evmcrispr/module-bridges": "*",
    "@evmcrispr/module-ens": "*",
    "@evmcrispr/module-giveth": "*",
    "@evmcrispr/module-governor": "*",
    "@evmcrispr/module-http": "*",
    "@evmcrispr/module-lang": "*",
    "@evmcrispr/module-lending": "*",
    "@evmcrispr/module-proxies": "*",
    "@evmcrispr/module-safe": "*",
    "@evmcrispr/module-sim": "*",
    "@evmcrispr/module-std": "*",
    "@evmcrispr/module-swaps": "*",
    "@evmcrispr/module-token": "*",
    "@evmcrispr/module-vault": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.2"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "biome check src scripts",
    "type-check": "tsgo --noEmit",
    "build": "evmcrispr-build --bundle src/index.ts src/order.ts",
    "codegen": "bun scripts/codegen.ts",
    "types": "evmcrispr-build --types"
  }
}
