{
  "name": "@evmcrispr/sdk",
  "version": "0.1.0",
  "license": "GPL-3.0",
  "description": "Module authoring toolkit for EVMcrispr",
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "jsymbol": "^0.3.5"
  },
  "devDependencies": {
    "@evmcrispr/test-utils": "workspace:*",
    "@types/bun": "^1.3.14",
    "abitype": "^1.2.4",
    "arcsecond": "^5.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "viem": "^2.54.1"
  },
  "bin": {
    "evmcrispr-build": "./scripts/build.ts"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "lint": "biome check src",
    "type-check": "tsgo -p tsconfig.json",
    "build": "evmcrispr-build"
  }
}
