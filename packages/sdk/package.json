{
  "name": "@evmcrispr/sdk",
  "version": "0.11.0",
  "description": "Module-authoring SDK for EVMcrispr: defineModule, defineCommand, defineHelper, shared types and build tooling",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EVMcrispr/evmcrispr.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://evmcrispr.com",
  "bugs": "https://github.com/EVMcrispr/evmcrispr/issues",
  "author": "Blossom Labs",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./onchain": {
      "bun": "./src/onchain/index.ts",
      "types": "./dist/onchain/index.d.ts",
      "import": "./dist/onchain/index.js"
    }
  },
  "dependencies": {
    "jsymbol": "^0.3.5"
  },
  "devDependencies": {
    "@evmcrispr/test-utils": "workspace:*",
    "@types/bun": "^1.3.14",
    "abitype": "^1.2.4",
    "arcsecond": "^5.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "viem": "^2.54.1"
  },
  "bin": {
    "evmcrispr-build": "./scripts/build.ts"
  },
  "files": [
    "dist",
    "scripts",
    "src"
  ],
  "scripts": {
    "lint": "biome check src",
    "type-check": "tsgo -p tsconfig.json",
    "test:unit": "bun test ./test/unit",
    "build": "evmcrispr-build --bundle ./src/index.ts ./src/onchain/index.ts --splitting",
    "codegen": "evmcrispr-build --codegen",
    "types": "evmcrispr-build --types"
  }
}
